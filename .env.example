# =============================================================================
# GEMA Technology — environment template
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# Environment: development | staging | production
# Production rejects insecure defaults and requires Redis for sessions/rate limits.
APP_ENV=development

# Database
POSTGRES_DB=gema
POSTGRES_USER=gema
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis (required when SESSION_BACKEND=redis or AUTH_RATE_LIMIT_BACKEND=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional password (required when Redis was started with --requirepass; staging compose sets this)
# REDIS_PASSWORD=

# Ports
API_PORT=8000
WEB_PORT=3000

# CORS (comma-separated origins allowed by the API)
# Include your LAN URL if you test from a phone, e.g. http://192.168.1.116:3000
# The same list feeds Next.js allowedDevOrigins so /_next assets load on that host.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookies
SESSION_COOKIE_NAME=gema_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=true  # auto-enabled in production
# development/tests: memory | production: redis (mandatory)
SESSION_BACKEND=memory

# OpenAPI / Swagger / ReDoc
# unset → enabled when APP_ENV != production; disabled in production
# OPENAPI_ENABLED=true
# OPENAPI_ENABLED=false

# Payments
# development defaults below are REJECTED when APP_ENV=production
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# development: manual | staging/production: payphone (manual rejected in production)
PAYMENT_DEFAULT_PROVIDER=manual
# unset → allowed in development/staging/test; blocked in production
# ALLOW_MANUAL_PAYMENT_CONFIRM=true
# ALLOW_MANUAL_PAYMENT_CONFIRM=false

# PayPhone (Ecuador) — https://docs.payphone.app/
# Create an API app in Payphone Developers; copy token + storeId.
# PAYMENT_DEFAULT_PROVIDER=payphone
# PAYPHONE_TOKEN=
# PAYPHONE_STORE_ID=
# PAYPHONE_API_BASE=https://pay.payphonetodoesposible.com
# Shared secret for Notificacion Externa (?token= or X-GEMA-Payment-Secret / x-payphone-webhook-secret).
# Required in staging/production when PAYMENT_DEFAULT_PROVIDER=payphone (fail-closed).
# PAYPHONE_WEBHOOK_SECRET=

# Offline bank transfer — seed values for Admin → Configuración (store_config).
# After first admin save, DB values win; env only seeds the singleton.
# Required for BANK_TRANSFER: BANK_NAME, BANK_ACCOUNT_NUMBER, BANK_ACCOUNT_HOLDER
# BANK_NAME=Banco Pichincha
# BANK_ACCOUNT_TYPE=Ahorros
# BANK_ACCOUNT_NUMBER=
# BANK_ACCOUNT_HOLDER=GEMA Technology
# BANK_ACCOUNT_ID=
# BANK_TRANSFER_INSTRUCTIONS=Usa el número de orden como referencia. El monto debe coincidir exactamente.

# Inventory reservation lifecycle
RESERVATION_TTL_HOURS=24
INTERNAL_JOB_SECRET=dev-internal-job-secret
# External scheduler (NOT an in-process FastAPI background task):
#   python -m app.scripts.expire_reservations [--loop]
#   docker compose --profile scheduler up -d
#   cron / systemd timer calling the one-shot script
RESERVATION_EXPIRE_ENABLED=true
RESERVATION_EXPIRE_INTERVAL_SECONDS=300

# Auth brute-force protection
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# unset → follows SESSION_BACKEND; production requires redis
# AUTH_RATE_LIMIT_BACKEND=memory
# AUTH_RATE_LIMIT_BACKEND=redis

# Commerce — shipping seed for Admin → Configuración; tax stays env-only for now
SHIPPING_ENABLED=true
SHIPPING_FLAT_RATE=5.00
SHIPPING_FREE_THRESHOLD=100.00
# SHIPPING_PROVINCE_RATES={"Galápagos":"12.00"}
# Sprint A3 opción A: enable IVA at checkout so PayPhone amount == factura total.
# Staging/production templates set true. Local demo may keep false (no FACTURA in stage/prod).
COMMERCE_TAX_ENABLED=false
COMMERCE_TAX_RATE=0.15

# Optional admin seed (never commit real passwords)
# Production template uses gematechnology17@gmail.com — see .env.production.example
# SEED_ADMIN_EMAIL=gematechnology17@gmail.com
# SEED_ADMIN_PASSWORD=change_me_admin

# Frontend → API proxy origin (Next.js rewrites) and reservation-expire job target.
# Server-side only — not exposed to the browser bundle as a public secret.
# Compose scheduler profile defaults to http://host.docker.internal:8000 when unset there.
API_ORIGIN=http://localhost:8000

# Smart search / sales assist (optional LLM; rules fallback always on)
# AI_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_MAX_OUTPUT_TOKENS=1024
# AI_TIMEOUT_SECONDS=30
# SEARCH_RATE_LIMIT=30

# Business info seed for quote PDFs / Admin → Configuración
# BUSINESS_NAME=GEMA Technology
# BUSINESS_RUC=
# BUSINESS_PHONE=
# BUSINESS_ADDRESS=
# BUSINESS_EMAIL=
# Optional absolute/relative path to company logo for PDFs (default: bundled gema_logo.jpg)
# BUSINESS_LOGO_PATH=

# SRI / facturación electrónica (Ecuador)
# Upload .p12 via Admin → Facturación SRI; password only via env (never in DB).
# SRI_CERT_PASSWORD=
# SRI_CERT_DIR=data/sri/certs
# SRI_PDF_DIR=data/sri/pdfs

# -----------------------------------------------------------------------------
# Transactional email (SMTP) — optional; never blocks checkout/payment/fulfillment
# -----------------------------------------------------------------------------
# EMAIL_ENABLED=false          # set true to attempt SMTP sends
# SMTP_HOST=                   # required when EMAIL_ENABLED=true
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=               # never commit real secrets
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=10
# PUBLIC_APP_URL=http://localhost:3000   # storefront base for email + invite links
# In production/staging set the real public domain (required when APP_ENV=production):
# PUBLIC_APP_URL=https://tu-dominio.com


# -----------------------------------------------------------------------------
# Staging checklist (see .env.staging.example + docs/ops/staging-runbook.md)
# -----------------------------------------------------------------------------
# APP_ENV=staging
# POSTGRES_PASSWORD=<strong unique secret>
# INTERNAL_JOB_SECRET=<strong unique secret>
# PAYMENT_WEBHOOK_SECRET=<strong unique secret>
# PAYMENT_DEFAULT_PROVIDER=payphone   # sandbox credentials only
# PAYPHONE_TOKEN=<sandbox token>
# PAYPHONE_STORE_ID=<sandbox storeId>
# PAYPHONE_WEBHOOK_SECRET=<strong unique secret>
# SESSION_BACKEND=redis
# AUTH_RATE_LIMIT_BACKEND=redis
# REDIS_PASSWORD=<strong unique secret>  # compose staging uses --requirepass
# CORS_ORIGINS=https://your-staging-origin   # no localhost
# PUBLIC_APP_URL=https://your-staging-origin
# SESSION_COOKIE_SECURE=true                 # auto when APP_ENV=staging
# EMAIL_ENABLED=true + SMTP → Mailpit (compose) or provider sandbox
# OPENAPI_ENABLED=false                      # recommended
# ALLOW_MANUAL_PAYMENT_CONFIRM=false         # recommended for staging drills
# Postgres/Redis: do not publish ports to the internet (staging compose keeps them internal)

# -----------------------------------------------------------------------------
# Production checklist (required) — see .env.production.example + docs/ops/production-runbook.md
# -----------------------------------------------------------------------------
# APP_ENV=production
# POSTGRES_PASSWORD=<strong unique secret>
# INTERNAL_JOB_SECRET=<strong unique secret>
# PAYMENT_WEBHOOK_SECRET=<strong unique secret>
# PAYMENT_DEFAULT_PROVIDER=payphone
# PAYPHONE_TOKEN=<token>
# PAYPHONE_STORE_ID=<storeId>
# PAYPHONE_WEBHOOK_SECRET=<strong unique secret>
# SESSION_BACKEND=redis
# AUTH_RATE_LIMIT_BACKEND=redis   # or omit to inherit SESSION_BACKEND=redis
# REDIS_PASSWORD=<strong unique secret>
# OPENAPI_ENABLED=false           # default when APP_ENV=production
# ALLOW_MANUAL_PAYMENT_CONFIRM=false  # default when APP_ENV=production
# CORS_ORIGINS=https://your-production-origin   # no localhost (Settings gate)
# PUBLIC_APP_URL=https://your-production-origin
# SESSION_COOKIE_SECURE=true
# COMMERCE_TAX_ENABLED=true       # Sprint A3 opción A
# COMMERCE_TAX_RATE=0.15
# EMAIL_ENABLED=false             # A4 outbox deferred
# Redis: do not publish unauthenticated Redis to a shared network in staging/prod
