# =============================================================================
# GEMA Technology — FREE demo stack (Vercel + Supabase + Upstash + Render)
# Copy values into each provider's dashboard. Never commit real secrets.
# Runbook: docs/ops/free-stack-deploy.md
# =============================================================================
# APP_ENV=staging so PayPhone can stay off (manual) while Redis + HTTPS gates apply.

APP_ENV=staging

# --- After you have the Vercel URL ---
PUBLIC_APP_URL=https://REPLACE_VERCEL_HOST.vercel.app
CORS_ORIGINS=https://REPLACE_VERCEL_HOST.vercel.app

# --- Supabase (Settings → Database → Connection string URI, use Transaction pooler) ---
# Paste the URI as DATABASE_URL on Render. Example shape:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.REPLACE:REPLACE_DB_PASSWORD@aws-0-REPLACE.pooler.supabase.com:6543/postgres

# --- Upstash Redis (REST not used — copy the Redis URL rediss://…) ---
REDIS_URL=rediss://default:REPLACE_UPSTASH_TOKEN@REPLACE.upstash.io:6379
SESSION_BACKEND=redis
AUTH_RATE_LIMIT_BACKEND=redis

SESSION_COOKIE_NAME=gema_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true

OPENAPI_ENABLED=false
ALLOW_MANUAL_PAYMENT_CONFIRM=true
PAYMENT_DEFAULT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=REPLACE_STRONG_PAYMENT_WEBHOOK_SECRET

INTERNAL_JOB_SECRET=REPLACE_STRONG_INTERNAL_JOB_SECRET
RESERVATION_TTL_HOURS=24
RESERVATION_EXPIRE_ENABLED=true

# Vercel build+runtime: public HTTPS URL of the Render API (no trailing slash)
API_ORIGIN=https://REPLACE_RENDER_SERVICE.onrender.com

# Commerce (demo)
COMMERCE_TAX_ENABLED=true
COMMERCE_TAX_RATE=0.15
SHIPPING_ENABLED=true
SHIPPING_FLAT_RATE=5.00
SHIPPING_FREE_THRESHOLD=100.00

EMAIL_ENABLED=false

AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# First SUPER_ADMIN after migrate + seed (Render shell / one-shot)
SEED_ADMIN_EMAIL=gematechnology17@gmail.com
SEED_ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD

# Optional later: PayPhone sandbox
# PAYMENT_DEFAULT_PROVIDER=payphone
# PAYPHONE_TOKEN=
# PAYPHONE_STORE_ID=
# PAYPHONE_WEBHOOK_SECRET=
# ALLOW_MANUAL_PAYMENT_CONFIRM=false
