# =============================================================================
# GEMA Technology — PRODUCTION environment template
# Copy to `.env.production` on the production host. Never commit real secrets.
# Used by: docker compose -f docker-compose.production.yml --env-file .env.production
# =============================================================================

APP_ENV=production

# Public HTTPS origins (operator DNS + reverse proxy — never localhost)
PUBLIC_APP_URL=https://REPLACE_PRODUCTION_FRONTEND_HOST
CORS_ORIGINS=https://REPLACE_PRODUCTION_FRONTEND_HOST

POSTGRES_DB=gema
POSTGRES_USER=gema
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD

SESSION_BACKEND=redis
AUTH_RATE_LIMIT_BACKEND=redis
SESSION_COOKIE_NAME=gema_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true

OPENAPI_ENABLED=false
ALLOW_MANUAL_PAYMENT_CONFIRM=false

API_HOST_PORT=8000
WEB_HOST_PORT=3000

INTERNAL_JOB_SECRET=REPLACE_STRONG_INTERNAL_JOB_SECRET
RESERVATION_TTL_HOURS=24
RESERVATION_EXPIRE_ENABLED=true
RESERVATION_EXPIRE_INTERVAL_SECONDS=300
API_ORIGIN=http://api:8000

# Live PayPhone credentials (operator-supplied — not sandbox)
PAYMENT_DEFAULT_PROVIDER=payphone
PAYMENT_WEBHOOK_SECRET=REPLACE_STRONG_PAYMENT_WEBHOOK_SECRET
PAYPHONE_TOKEN=REPLACE_PAYPHONE_LIVE_TOKEN
PAYPHONE_STORE_ID=REPLACE_PAYPHONE_LIVE_STORE_ID
PAYPHONE_API_BASE=https://pay.payphonetodoesposible.com
PAYPHONE_WEBHOOK_SECRET=REPLACE_STRONG_PAYPHONE_WEBHOOK_SECRET
# Notificacion Externa (HTTPS public), e.g.:
#   https://REPLACE_PRODUCTION_FRONTEND_HOST/api/v1/payments/webhooks/payphone?token=<PAYPHONE_WEBHOOK_SECRET>

# Sprint A3 opción A
COMMERCE_TAX_ENABLED=true
COMMERCE_TAX_RATE=0.15
SHIPPING_ENABLED=true
SHIPPING_FLAT_RATE=5.00
SHIPPING_FREE_THRESHOLD=100.00

# Email durable (A4) deferred — keep disabled until outbox/SMTP prod validated
EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# BUSINESS_NAME=GEMA Technology
# BUSINESS_RUC=
# BUSINESS_EMAIL=
# SRI_CERT_PASSWORD=
# SRI_CERT_DIR=data/sri/certs
# SRI_PDF_DIR=data/sri/pdfs

# First SUPER_ADMIN (run once after migrate: docker compose … run --rm api python -m app.scripts.seed)
# Set a strong unique password in the real .env.production — never commit it.
SEED_ADMIN_EMAIL=gematechnology17@gmail.com
SEED_ADMIN_PASSWORD=Jefferson_1993
