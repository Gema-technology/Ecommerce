# =============================================================================
# GEMA Technology — STAGING environment template
# Copy to `.env.staging` on the staging host. Never commit real secrets.
# Used by: docker compose -f docker-compose.staging.yml --env-file .env.staging
# =============================================================================

# --- Operator must replace all REPLACE_* and URL placeholders -----------------
APP_ENV=staging

# Public HTTPS origins (set by your DNS + reverse proxy — do not use localhost)
PUBLIC_APP_URL=https://REPLACE_STAGING_FRONTEND_HOST
CORS_ORIGINS=https://REPLACE_STAGING_FRONTEND_HOST

# Database (Postgres service name on the staging compose network)
POSTGRES_DB=gema
POSTGRES_USER=gema
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (requirepass in compose; password required for authenticated Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD

# Sessions + auth rate limit (mandatory for staging Settings gates)
SESSION_BACKEND=redis
AUTH_RATE_LIMIT_BACKEND=redis
SESSION_COOKIE_NAME=gema_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
# Auto Secure=true when APP_ENV=staging; keep true behind HTTPS proxy
SESSION_COOKIE_SECURE=true

# OpenAPI — optional in staging; set false to hide /docs
OPENAPI_ENABLED=false

# Host bind ports (loopback only in compose — reverse proxy terminates TLS)
API_HOST_PORT=8000
WEB_HOST_PORT=3000
MAILPIT_UI_PORT=8025

# Internal jobs
INTERNAL_JOB_SECRET=REPLACE_STRONG_INTERNAL_JOB_SECRET
RESERVATION_TTL_HOURS=24
RESERVATION_EXPIRE_ENABLED=true
RESERVATION_EXPIRE_INTERVAL_SECONDS=300
API_ORIGIN=http://api:8000

# Payments — sandbox PayPhone only (no live credentials)
PAYMENT_DEFAULT_PROVIDER=payphone
PAYMENT_WEBHOOK_SECRET=REPLACE_STRONG_PAYMENT_WEBHOOK_SECRET
# From PayPhone Developers sandbox app (operator-supplied):
PAYPHONE_TOKEN=REPLACE_PAYPHONE_SANDBOX_TOKEN
PAYPHONE_STORE_ID=REPLACE_PAYPHONE_SANDBOX_STORE_ID
PAYPHONE_API_BASE=https://pay.payphonetodoesposible.com
PAYPHONE_WEBHOOK_SECRET=REPLACE_STRONG_PAYPHONE_WEBHOOK_SECRET
# Notificacion Externa URL (configure in PayPhone console — HTTPS public):
#   https://REPLACE_STAGING_FRONTEND_HOST/api/v1/payments/webhooks/payphone?token=<PAYPHONE_WEBHOOK_SECRET>
# Manual admin confirm remains allowed in staging by default; keep false if undesired:
ALLOW_MANUAL_PAYMENT_CONFIRM=false

# Transactional email → Mailpit (compose service). A1 hooks only; no A4 outbox.
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@staging.example
SMTP_TIMEOUT_SECONDS=10

# Commerce — Sprint A3 opción A (precio + IVA)
COMMERCE_TAX_ENABLED=true
COMMERCE_TAX_RATE=0.15
SHIPPING_ENABLED=true
SHIPPING_FLAT_RATE=5.00
SHIPPING_FREE_THRESHOLD=100.00

# Auth rate limits
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional business seed
# BUSINESS_NAME=GEMA Technology
# BUSINESS_EMAIL=
# BUSINESS_RUC=

# SRI — use pruebas credentials only; never production certs in staging cutover
# SRI_CERT_PASSWORD=
# SRI_CERT_DIR=data/sri/certs
# SRI_PDF_DIR=data/sri/pdfs
